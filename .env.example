# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me

# Database
DATABASE_PATH=./data/traffic_analyzer.db

# Capture
CAPTURE_INTERFACE=eth0

# Security detection thresholds (example — tune as needed)
PORT_SCAN_DISTINCT_PORTS_THRESHOLD=15
PORT_SCAN_TIME_WINDOW_SECONDS=10
ABNORMAL_TRAFFIC_PACKETS_PER_SECOND_THRESHOLD=500
